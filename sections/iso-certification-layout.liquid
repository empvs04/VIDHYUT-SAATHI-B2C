      <p class="iso-subheading">{{ section.settings.cta_text }}</p>
      <a href="{{ section.settings.cta_link }}" class="iso-cta-btn">{{ section.settings.cta_btn_text }}</a>
    </div>
  </section>

</div>

<script>
  function renderIsoPdfCertificate() {
    const pdfUrl = "{{ 'iso-certificate.pdf' | asset_url }}";
    if (typeof pdfjsLib !== 'undefined' && pdfUrl) {
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
      
      pdfjsLib.getDocument(pdfUrl).promise.then(function(pdf) {
        pdf.getPage(1).then(function(page) {
          const scale = 2.5; // High resolution 300 DPI render scale
          const viewport = page.getViewport({ scale: scale });
          
          ['iso-pdf-canvas-1', 'iso-pdf-canvas-2'].forEach(function(canvasId) {
            const canvas = document.getElementById(canvasId);
            if (canvas) {
              const context = canvas.getContext('2d');
              canvas.height = viewport.height;
              canvas.width = viewport.width;
              page.render({ canvasContext: context, viewport: viewport });
            }
          });
        });
      }).catch(function(err) {
        console.warn('PDF.js rendering fallback to image:', err);
        const fallback1 = document.getElementById('iso-pdf-fallback-1');
        if (fallback1) fallback1.style.display = 'block';
        const canvas1 = document.getElementById('iso-pdf-canvas-1');
        if (canvas1) canvas1.style.display = 'none';
        const fallback2 = document.getElementById('iso-pdf-fallback-2');
        if (fallback2) fallback2.style.display = 'block';
        const canvas2 = document.getElementById('iso-pdf-canvas-2');
        if (canvas2) canvas2.style.display = 'none';
      });
    }
  }
  document.addEventListener("DOMContentLoaded", renderIsoPdfCertificate);
  if (window.Shopify && Shopify.designMode) { setTimeout(renderIsoPdfCertificate, 300); }
</script>

