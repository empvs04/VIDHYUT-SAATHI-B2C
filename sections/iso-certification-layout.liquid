    <div class="hero-breadcrumb-pill">
      <a href="/">Home</a>
      <span style="color: #ffcc00;">/</span>
      <span style="color: #ffffff; font-weight: 700; font-size: 0.92rem;">{{ section.settings.hero_title }}</span>
    </div>
  </section>

  <!-- Showcase & Details -->
  <section class="iso-showcase">
    <div class="iso-grid">
      
      <!-- Certificate Viewer with 300 DPI PDF.js Ultra-HD Vector Canvas -->
      <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
      <div class="iso-cert-box">
        <div class="iso-cert-img-wrapper" id="iso-canvas-container-1">
          <canvas id="iso-pdf-canvas-1" style="width: 100%; height: auto; display: block; border-radius: 14px; box-shadow: 0 10px 30px rgba(0,0,0,0.15);"></canvas>
          <img id="iso-pdf-fallback-1" src="{{ 'iso-certificate.jpg' | asset_url }}" alt="Official ISO 9001:2015 Certificate of Registration - Vidhyut Saathi" loading="eager" width="2400" height="3394" style="width: 100%; height: auto; display: none; border-radius: 14px; image-rendering: -webkit-optimize-contrast;">
        </div>
        
        <a href="{{ 'iso-certificate.pdf' | asset_url }}" target="_blank" rel="noopener noreferrer" class="iso-cert-btn" download="Vidhyut_Saathi_ISO_9001_Certificate.pdf">
          <i class="fa-solid fa-file-pdf" style="margin-right: 8px;"></i> Download Full HD ISO Certificate (PDF)
        </a>
      </div>

      <!-- Text Details -->
      <div class="iso-details-box">
        <div class="iso-badge">
          <div class="pulse-dot"></div>
          100% Verified & Compliant
        </div>
        <h2>{{ section.settings.details_heading | default: "ISO 9001:2015 Certified (IAF Certified)" }}</h2>
        <div class="iso-main-text">
