          {%- else -%}
            <p>Proudly ISO 9001:2015 Certified (IAF Certified), Vidhyut Saathi follows internationally recognized quality management standards. IAF (International Accreditation Forum) is one of the world's most respected accreditation associations, ensuring that our certification is globally recognized. This reflects our commitment to quality, reliability, transparency, and consistent customer satisfaction—giving our customers and business partners greater confidence in every product and service we deliver.</p>
          {%- endif -%}
        </div>
        
        <div class="iso-data-grid">
          {%- if section.settings.detail_standard != blank -%}
            <div class="iso-data-item">
              <div class="iso-data-label">Standard</div>
              <div class="iso-data-value">{{ section.settings.detail_standard }}</div>
            </div>
          {%- endif -%}
          
          {%- if section.settings.detail_body != blank -%}
            <div class="iso-data-item">
              <div class="iso-data-label">Accreditation Body</div>
              <div class="iso-data-value">{{ section.settings.detail_body }}</div>
            </div>
          {%- endif -%}
          
          {%- if section.settings.detail_number != blank -%}
            <div class="iso-data-item">
              <div class="iso-data-label">Certificate No.</div>
              <div class="iso-data-value">{{ section.settings.detail_number }}</div>
            </div>
          {%- endif -%}
          
          {%- if section.settings.detail_issue != blank -%}
