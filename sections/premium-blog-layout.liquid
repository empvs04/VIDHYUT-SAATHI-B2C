{%- style -%}
  :root {
    --blog-primary: {{ section.settings.primary_color | default: '#ec5c0a' }};
    --blog-bg: {{ section.settings.bg_color | default: '#fdfdfd' }};
    --blog-text-dark: #1a1a1a;
    --blog-text-light: #555555;
    --blog-radius: 12px;
    --blog-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    --blog-shadow-hover: 0 10px 25px rgba(0, 0, 0, 0.08);
  }
  
  .blog-wrapper {
    font-family: 'Poppins', 'Inter', sans-serif;
    background: var(--blog-bg);
    color: var(--blog-text-dark);
  }

  /* Hero Section */
  .blog-hero {
    position: relative;
    padding: clamp(60px, 8vw, 100px) 20px;
    text-align: center;
    background: #111;
    color: #fff;
    overflow: hidden;
  }
  .blog-hero-bg {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 1;
  }
  .blog-hero-bg img {
    width: 100%; height: 100%; object-fit: cover; opacity: 0.4;
  }
  .blog-hero-content {
    position: relative;
    z-index: 2;
    max-width: 800px;
    margin: 0 auto;
  }
  .blog-hero h1 {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    margin-bottom: 15px;
    color: #fff;
  }
  .blog-hero p {
    font-size: clamp(1.1rem, 2vw, 1.3rem);
    color: #eee;
  }

  /* Search & Filter Bar */
  .blog-toolbar {
    max-width: 1280px;
    margin: 0 auto;
    padding: 30px 20px;
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    justify-content: space-between;
    align-items: center;
  }
  .blog-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .blog-tag-btn {
    padding: 8px 16px;
    border-radius: 50px;
    background: #fff;
    border: 1px solid #ddd;
    color: var(--blog-text-dark);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 500;
    transition: all 0.2s ease;
  }
  .blog-tag-btn:hover, .blog-tag-btn.active {
    background: var(--blog-primary);
    color: #fff;
    border-color: var(--blog-primary);
  }
  .blog-search-form {
    display: flex;
    width: 100%;
    max-width: 400px;
    position: relative;
  }
  .blog-search-input {
    width: 100%;
    padding: 12px 20px 12px 45px;
    border-radius: 50px;
    border: 1px solid #ddd;
    font-family: inherit;
    outline: none;
  }
  .blog-search-input:focus {
    border-color: var(--blog-primary);
  }
  .blog-search-icon {
    position: absolute;
    left: 15px;
    top: 50%;
    transform: translateY(-50%);
    color: #999;
  }

  /* Featured Article */
  .blog-featured {
    max-width: 1280px;
    margin: 0 auto;
    padding: 20px;
  }
  .blog-feat-card {
    display: grid;
    grid-template-columns: 1fr;
    background: #fff;
    border-radius: var(--blog-radius);
    overflow: hidden;
    box-shadow: var(--blog-shadow);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.3s ease;
  }
  .blog-feat-card:hover {
    box-shadow: var(--blog-shadow-hover);
  }
  @media(min-width: 912px) {
    .blog-feat-card { grid-template-columns: 3fr 2fr; }
  }
  .blog-feat-img {
    position: relative;
    min-height: 300px;
  }
  .blog-feat-img img {
    position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover;
  }
  .blog-feat-content {
    padding: clamp(30px, 4vw, 50px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .blog-card-tag {
    color: var(--blog-primary);
    font-weight: 700;
    font-size: 0.85rem;
    text-transform: uppercase;
    margin-bottom: 15px;
  }
  .blog-feat-content h2 {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    font-weight: 700;
    margin-bottom: 15px;
  }
  .blog-feat-content p {
    color: var(--blog-text-light);
    line-height: 1.6;
    margin-bottom: 20px;
  }
  .blog-meta {
    font-size: 0.85rem;
    color: #888;
  }

  /* Grid Area */
  .blog-grid-section {
    max-width: 1280px;
    margin: 0 auto;
    padding: clamp(40px, 6vw, 80px) 20px;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }
  @media(min-width: 768px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
  @media(min-width: 1024px) { .blog-grid { grid-template-columns: repeat(3, 1fr); } }

  .blog-card {
    background: #fff;
    border-radius: var(--blog-radius);
    overflow: hidden;
    box-shadow: var(--blog-shadow);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    display: flex;
    flex-direction: column;
  }
  .blog-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--blog-shadow-hover);
  }
  .blog-card-img {
    height: 220px;
    overflow: hidden;
    position: relative;
  }
  .blog-card-img img {
    width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;
  }
  .blog-card:hover .blog-card-img img { transform: scale(1.05); }
  .blog-card-content {
    padding: 25px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .blog-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 10px;
    color: var(--blog-text-dark);
    text-decoration: none;
  }
  .blog-card-excerpt {
    color: var(--blog-text-light);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 20px;
    flex-grow: 1;
  }
  .blog-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #eee;
    padding-top: 15px;
    margin-top: auto;
  }
  .blog-read-more {
    color: var(--blog-primary);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }

  /* Pagination */
  .blog-pagination {
    text-align: center;
    margin-top: 50px;
  }
  .blog-pagination span, .blog-pagination a {
    display: inline-block;
    padding: 10px 16px;
    margin: 0 5px;
    border-radius: 5px;
    background: #fff;
    border: 1px solid #ddd;
    color: var(--blog-text-dark);
    text-decoration: none;
    font-weight: 600;
  }
  .blog-pagination .current {
    background: var(--blog-primary);
    color: #fff;
    border-color: var(--blog-primary);
  }

  /* Newsletter CTA */
  .blog-newsletter {
    background: linear-gradient(135deg, #1a1a1a 0%, #333 100%);
    color: #fff;
    padding: clamp(60px, 8vw, 100px) 20px;
    text-align: center;
  }
  .newsletter-inner { max-width: 600px; margin: 0 auto; }
  .newsletter-inner h2 { color: #fff; margin-bottom: 10px; }
  .newsletter-inner p { color: #ccc; margin-bottom: 30px; }
  .newsletter-form { display: flex; gap: 10px; max-width: 450px; margin: 0 auto; }
  .newsletter-input { flex-grow: 1; padding: 12px 20px; border-radius: 50px; border: none; outline: none; }
  .newsletter-btn { padding: 12px 30px; border-radius: 50px; background: var(--blog-primary); color: #fff; border: none; font-weight: 600; cursor: pointer; transition: background 0.3s ease; }
  .newsletter-btn:hover { background: #d45007; }
  @media(max-width: 480px) {
    .newsletter-form { flex-direction: column; }
  }
{%- endstyle -%}

<div class="blog-wrapper">

  <!-- Hero Section -->
  <section class="blog-hero">
    {%- if section.settings.hero_image != blank -%}
      <div class="blog-hero-bg">
        {{ section.settings.hero_image | image_url: width: 2000 | image_tag: loading: 'lazy' }}
      </div>
    {%- endif -%}
    <div class="blog-hero-content">
      <h1>{{ section.settings.hero_title }}</h1>
      <p>{{ section.settings.hero_subtitle }}</p>
    </div>
  </section>

  <!-- Toolbar: Categories & Search -->
  <section class="blog-toolbar">
    <div class="blog-tags">
      <a href="{{ blog.url }}" class="blog-tag-btn {% if current_tags == blank %}active{% endif %}">All</a>
      {%- for tag in blog.all_tags -%}
        <a href="{{ blog.url }}/tagged/{{ tag | handle }}" class="blog-tag-btn {% if current_tags contains tag %}active{% endif %}">
          {{ tag }}
        </a>
      {%- endfor -%}
    </div>
    
    <form action="{{ routes.search_url }}" method="get" class="blog-search-form" role="search">
      <input type="hidden" name="type" value="article">
      <span class="blog-search-icon">🔍</span>
      <input class="blog-search-input" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search articles...">
    </form>
  </section>

  <!-- Paginated Content -->
  {%- paginate blog.articles by section.settings.articles_per_page -%}
    
    <!-- Featured Article (Only on page 1 and no tags active) -->
    {%- if paginate.current_page == 1 and current_tags == blank and blog.articles.size > 0 -%}
      {%- assign featured_article = blog.articles.first -%}
      <section class="blog-featured">
        <a href="{{ featured_article.url }}" class="blog-feat-card">
          <div class="blog-feat-img">
            {%- if featured_article.image -%}
              {{ featured_article.image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="blog-feat-content">
            {%- if featured_article.tags.size > 0 -%}
              <span class="blog-card-tag">{{ featured_article.tags.first }}</span>
            {%- endif -%}
            <h2>{{ featured_article.title }}</h2>
            <p>
              {%- if featured_article.excerpt.size > 0 -%}
                {{ featured_article.excerpt | strip_html | truncatewords: 30 }}
              {%- else -%}
                {{ featured_article.content | strip_html | truncatewords: 30 }}
              {%- endif -%}
            </p>
            <div class="blog-meta">{{ featured_article.published_at | date: "%B %d, %Y" }}</div>
          </div>
        </a>
      </section>
    {%- endif -%}

    <!-- Main Article Grid -->
    <section class="blog-grid-section">
      <div class="blog-grid">
        {%- for article in blog.articles -%}
          <!-- Skip the first article if we are on page 1 without tags (since it's featured) -->
          {%- if paginate.current_page == 1 and current_tags == blank and forloop.first -%}
            {%- continue -%}
          {%- endif -%}
          
          <div class="blog-card">
            <a href="{{ article.url }}" class="blog-card-img">
              {%- if article.image -%}
                {{ article.image | image_url: width: 600 | image_tag: loading: 'lazy' }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </a>
            <div class="blog-card-content">
              {%- if article.tags.size > 0 -%}
                <span class="blog-card-tag">{{ article.tags.first }}</span>
              {%- endif -%}
              <a href="{{ article.url }}" class="blog-card-title">{{ article.title }}</a>
              <div class="blog-card-excerpt">
                {%- if article.excerpt.size > 0 -%}
                  {{ article.excerpt | strip_html | truncatewords: 20 }}
                {%- else -%}
                  {{ article.content | strip_html | truncatewords: 20 }}
                {%- endif -%}
              </div>
              <div class="blog-card-footer">
                <span class="blog-meta">{{ article.published_at | date: "%B %d, %Y" }}</span>
                <a href="{{ article.url }}" class="blog-read-more">Read More →</a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <div class="blog-pagination">
          {{ paginate | default_pagination }}
        </div>
      {%- endif -%}
    </section>
  {%- endpaginate -%}

  <!-- Newsletter CTA -->
  <section class="blog-newsletter">
    <div class="newsletter-inner">
      <h2>{{ section.settings.cta_heading }}</h2>
      <p>{{ section.settings.cta_text }}</p>
      
      {% form 'customer', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <input type="email" name="contact[email]" class="newsletter-input" placeholder="Enter your email address" required>
        <button type="submit" class="newsletter-btn">Subscribe</button>
      {% endform %}
    </div>
  </section>

</div>

{% schema %}
{
  "name": "Premium Blog Layout",
  "settings": [
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Accent Color",
      "default": "#ec5c0a"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdfdfd"
    },
    {
      "type": "header",
      "content": "Hero Section"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Hero Title",
      "default": "Vidhyut Saathi Blog"
    },
    {
      "type": "text",
      "id": "hero_subtitle",
      "label": "Hero Subtitle",
      "default": "Insights, Ideas & Knowledge for a Smarter Energy Future"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Banner Image"
    },
    {
      "type": "header",
      "content": "Grid Settings"
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12,
      "label": "Articles per page"
    },
    {
      "type": "header",
      "content": "Newsletter CTA"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "Heading",
      "default": "Stay Updated with Vidhyut Saathi"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Subheading",
      "default": "Get the latest energy saving tips and company news delivered to your inbox."
    }
  ]
}
{% endschema %}
