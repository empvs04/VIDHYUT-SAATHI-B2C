    <h1>
      {% if active_policy == 'privacy' %}Privacy Policy
      {% elsif active_policy == 'terms' %}Terms &amp; Conditions
      {% elsif active_policy == 'refund' %}Return &amp; Refund Policy
      {% elsif active_policy == 'shipping' %}Shipping Policy
      {% elsif active_policy == 'legal' %}Legal Notice
      {% elsif active_policy == 'disclaimer' %}Disclaimer
      {% elsif active_policy == 'contact' %}Contact Information
      {% else %}Customer Policy &amp; Terms{% endif %}
    </h1>
    <p>Official legal guidelines, terms, warranties, and privacy protection protocols for Vidhyut Saathi Energy Savers Pvt Ltd.</p>
  </div>

  <!-- Container -->
