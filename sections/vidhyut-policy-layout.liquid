{%- style -%}
  :root {
    --pol-primary: #f17e39;
    --pol-primary-dark: #d96924;
    --pol-secondary: #007b3e;
    --pol-bg: #090e1a;
    --pol-card-bg: rgba(30, 41, 59, 0.7);
    --pol-text: #e2e8f0;
    --pol-muted: #94a3b8;
    --pol-border: rgba(255, 255, 255, 0.1);
  }

  .vs-policy-wrapper {
    font-family: 'Plus Jakarta Sans', 'Inter', system-ui, sans-serif;
    background: radial-gradient(circle at 50% 0%, #1e293b 0%, #0f172a 60%, #020617 100%);
    color: var(--pol-text);
    min-height: 100vh;
    padding-bottom: 80px;
    position: relative;
    overflow: hidden;
  }

  .vs-policy-glow-1 {
    position: absolute;
    top: -150px;
    left: 10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(241, 126, 57, 0.12) 0%, rgba(0,0,0,0) 70%);
    pointer-events: none;
  }

  .vs-policy-glow-2 {
    position: absolute;
    bottom: -150px;
    right: 10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(0, 123, 62, 0.12) 0%, rgba(0,0,0,0) 70%);
    pointer-events: none;
  }

  /* Hero Section */
  .vs-policy-hero {
    padding: 70px 20px 40px;
    text-align: center;
    position: relative;
    z-index: 2;
    border-bottom: 1px solid var(--pol-border);
    background: rgba(15, 23, 42, 0.6);
    backdrop-filter: blur(12px);
  }

  .vs-policy-hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(241, 126, 57, 0.15);
    border: 1px solid rgba(241, 126, 57, 0.4);
    color: #f17e39;
    padding: 6px 16px;
    border-radius: 30px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 16px;
  }

  .vs-policy-hero h1 {
    font-size: clamp(2.2rem, 4vw, 3.2rem);
    font-weight: 800;
    color: #ffffff;
    margin: 0 0 12px;
    letter-spacing: -0.5px;
  }

  .vs-policy-hero p {
    color: var(--pol-muted);
    font-size: 1.05rem;
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }

  /* Main Layout */
  .vs-policy-container {
    max-width: 1280px;
    margin: 40px auto 0;
    padding: 0 20px;
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 36px;
    position: relative;
    z-index: 2;
  }

  /* Sidebar Nav */
  .vs-policy-sidebar {
    background: var(--pol-card-bg);
    border: 1px solid var(--pol-border);
    border-radius: 20px;
    padding: 24px;
    backdrop-filter: blur(16px);
    height: fit-content;
    position: sticky;
    top: 100px;
  }

  .vs-policy-sidebar-title {
    color: #ffffff;
    font-size: 1.1rem;
    font-weight: 800;
    margin: 0 0 18px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .vs-policy-nav {
    display: flex;
    flex-direction: column;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .vs-policy-nav a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: 12px;
    color: var(--pol-muted);
    text-decoration: none;
    font-size: 0.93rem;
    font-weight: 600;
    transition: all 0.3s ease;
    border: 1px solid transparent;
  }

  .vs-policy-nav a i {
    font-size: 1rem;
    color: var(--pol-primary);
    width: 20px;
    text-align: center;
  }

  .vs-policy-nav a:hover,
  .vs-policy-nav a.active {
    background: linear-gradient(135deg, rgba(241, 126, 57, 0.2) 0%, rgba(241, 126, 57, 0.05) 100%);
    border-color: rgba(241, 126, 57, 0.4);
    color: #ffffff;
    transform: translateX(4px);
  }

  /* Content Card */
  .vs-policy-content-card {
    background: var(--pol-card-bg);
    border: 1px solid var(--pol-border);
    border-radius: 24px;
    padding: 40px;
    backdrop-filter: blur(16px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
  }

  .vs-policy-header-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 20px;
    margin-bottom: 30px;
    border-bottom: 1px solid var(--pol-border);
    flex-wrap: wrap;
    gap: 12px;
  }

  .vs-policy-effective-date {
    background: rgba(0, 123, 62, 0.2);
    border: 1px solid rgba(0, 123, 62, 0.4);
    color: #4ade80;
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 0.82rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .vs-policy-body h2 {
    color: #ffffff;
    font-size: 1.4rem;
    font-weight: 800;
    margin: 30px 0 14px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .vs-policy-body h2::before {
    content: '';
    width: 4px;
    height: 20px;
    background: var(--pol-primary);
    border-radius: 2px;
  }

  .vs-policy-body h3 {
    color: #f8fafc;
    font-size: 1.15rem;
    font-weight: 700;
    margin: 22px 0 10px;
  }

  .vs-policy-body p {
    color: var(--pol-text);
    font-size: 0.98rem;
    line-height: 1.75;
    margin: 0 0 16px;
  }

  .vs-policy-body ul, .vs-policy-body ol {
    margin: 0 0 20px 20px;
    color: var(--pol-text);
  }

  .vs-policy-body li {
    margin-bottom: 8px;
    line-height: 1.7;
    font-size: 0.98rem;
  }

  .vs-policy-highlight-box {
    background: linear-gradient(135deg, rgba(241, 126, 57, 0.12) 0%, rgba(241, 126, 57, 0.03) 100%);
    border: 1px solid rgba(241, 126, 57, 0.3);
    border-radius: 16px;
    padding: 20px 24px;
    margin: 24px 0;
  }

  .vs-policy-highlight-box h4 {
    color: var(--pol-primary);
    margin: 0 0 8px;
    font-size: 1.05rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .vs-policy-highlight-box p {
    margin: 0;
    font-size: 0.94rem;
  }

  .vs-policy-contact-card {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--pol-border);
    border-radius: 16px;
    padding: 24px;
    margin-top: 30px;
  }

  .vs-policy-contact-card h4 {
    color: #ffffff;
    margin: 0 0 12px;
    font-size: 1.1rem;
    font-weight: 800;
  }

  @media (max-width: 900px) {
    .vs-policy-container {
      grid-template-columns: 1fr;
    }
    .vs-policy-sidebar {
      position: relative;
      top: 0;
    }
    .vs-policy-content-card {
      padding: 24px 20px;
    }
  }
{%- endstyle -%}

{% liquid
  assign current_handle = page.handle | default: section.settings.default_policy
  if current_handle contains 'privacy'
    assign active_policy = 'privacy'
  elsif current_handle contains 'terms'
    assign active_policy = 'terms'
  elsif current_handle contains 'refund' or current_handle contains 'return'
    assign active_policy = 'refund'
  elsif current_handle contains 'shipping'
    assign active_policy = 'shipping'
  elsif current_handle contains 'legal'
    assign active_policy = 'legal'
  elsif current_handle contains 'disclaimer'
    assign active_policy = 'disclaimer'
  elsif current_handle contains 'contact'
    assign active_policy = 'contact'
  else
    assign active_policy = section.settings.default_policy | default: 'privacy'
  endif
%}

<div class="vs-policy-wrapper">
  <div class="vs-policy-glow-1"></div>
  <div class="vs-policy-glow-2"></div>

  <!-- Hero Header -->
  <div class="vs-policy-hero">
