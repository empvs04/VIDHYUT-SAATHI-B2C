        <i class="fa-solid fa-scale-balanced" style="color: var(--pol-primary);"></i> All Policies
      </div>
      <ul class="vs-policy-nav">
        <li>
          <a href="/pages/privacy-policy" class="{% if active_policy == 'privacy' %}active{% endif %}">
            <i class="fa-solid fa-user-shield"></i> Privacy Policy
          </a>
        </li>
        <li>
          <a href="/pages/terms-and-conditions" class="{% if active_policy == 'terms' %}active{% endif %}">
            <i class="fa-solid fa-file-contract"></i> Terms &amp; Conditions
          </a>
        </li>
        <li>
          <a href="/pages/return-refund-policy" class="{% if active_policy == 'refund' %}active{% endif %}">
            <i class="fa-solid fa-rotate-left"></i> Return &amp; Refund
          </a>
        </li>
        <li>
          <a href="/pages/shipping-policy" class="{% if active_policy == 'shipping' %}active{% endif %}">
            <i class="fa-solid fa-truck-fast"></i> Shipping Policy
          </a>
        </li>
        <li>
          <a href="/pages/legal-notice" class="{% if active_policy == 'legal' %}active{% endif %}">
            <i class="fa-solid fa-scale-balanced"></i> Legal Notice
          </a>
        </li>
        <li>
          <a href="/pages/disclaimer" class="{% if active_policy == 'disclaimer' %}active{% endif %}">
            <i class="fa-solid fa-triangle-exclamation"></i> Disclaimer
          </a>
        </li>
        <li>
          <a href="/pages/contact-information" class="{% if active_policy == 'contact' %}active{% endif %}">
            <i class="fa-solid fa-address-card"></i> Contact Information
          </a>
        </li>
      </ul>
    </div>

