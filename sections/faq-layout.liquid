<div class="faq-wrapper">
  
  <!-- Hero Section -->
  <section class="faq-hero">
    <div class="faq-moving-text">Frequently Asked Questions &nbsp; &nbsp; FAQs &nbsp; &nbsp; Frequently Asked Questions</div>
    
    <div class="faq-hero-content">
      <div class="hero-breadcrumb-pill">
        <a href="/">Home</a>
        <span style="color: #ffcc00;">/</span>
        <span style="color: #ffffff; font-weight: 700;">FAQs</span>
        <span style="color: rgba(255,255,255,0.3); margin: 0 4px;">|</span>
        <span style="color: #ffcc00; font-weight: 800;"><span class="pulse-dot"></span> 2 Million+ Trusted</span>
      </div>

      <div class="faq-badge-top">
        <span class="pulse-dot"></span>
        <span>⚡ OFFICIAL KNOWLEDGE BASE &amp; HELP CENTER</span>
      </div>

      <h1>Frequently Asked <span>Questions (FAQs)</span></h1>
      <p class="faq-subheading">Everything you need to know about the Vidhyut Saathi Card, working technology, installation, safety, warranty, and exclusive district franchise opportunities.</p>
      
      {%- if section.settings.enable_search -%}
        <div class="faq-search-container">
          <span class="faq-search-icon">🔍</span>
          <input type="text" id="faqSearchInput" class="faq-search-input" placeholder="Type your question or keyword (e.g. Installation, Warranty, Franchise, Safety)..." aria-label="Search FAQs">
        </div>
      {%- endif -%}
    </div>
  </section>

  <!-- Category Filter Tabs -->
  <div class="faq-categories-wrapper">
    <div class="faq-categories" id="faqCategories">
      <button class="faq-cat-btn active" data-filter="all">✨ All Questions</button>
      <button class="faq-cat-btn" data-filter="working">⚡ Product &amp; Tech</button>
      <button class="faq-cat-btn" data-filter="installation">🔧 Installation &amp; Load</button>
      <button class="faq-cat-btn" data-filter="safety">🛡️ Safety &amp; Warranty</button>
      <button class="faq-cat-btn" data-filter="franchise">💼 Franchise &amp; Business</button>
    </div>
  </div>

  <!-- FAQ Content Section -->
  <section class="faq-content-section">
    <div class="faq-list" id="faqList">
      
      {%- if section.blocks.size > 0 -%}
