{%- style -%}
  /* --- Global & Variables --- */
  :root {
    --faq-primary: {{ section.settings.primary_color | default: '#ec5c0a' }};
    --faq-secondary: #007b3e;
    --faq-bg: {{ section.settings.bg_color | default: '#fff8ef' }};
    --faq-text-dark: #0f172a;
    --faq-text-light: #334155;
    --faq-radius: 20px;
    --faq-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
    --faq-shadow-hover: 0 20px 45px rgba(236, 92, 10, 0.14);
    --faq-border: rgba(236, 92, 10, 0.15);
  }
  
  .faq-wrapper {
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Inter', sans-serif;
    color: var(--faq-text-dark);
    background: radial-gradient(circle at 50% 0%, rgba(236, 92, 10, 0.08) 0%, #ffffff 40%, rgba(0, 123, 62, 0.06) 100%);
    overflow: hidden;
  }

  /* --- Hero Section --- */
  .faq-hero {
    position: relative;
    padding: clamp(60px, 8vw, 100px) 20px 50px 20px;
    text-align: center;
    background: linear-gradient(135deg, #090e1a 0%, #151d30 50%, #0d1527 100%);
    color: #ffffff;
    overflow: hidden;
    border-bottom: 2px solid rgba(255, 204, 0, 0.3);
  }

  /* --- Left to Right Moving Marquee Text --- */
  @keyframes scroll-left-to-right {
    0% { transform: translateX(-50%) translateY(0); }
    100% { transform: translateX(50%) translateY(0); }
  }
  .faq-moving-text {
    position: absolute;
    top: 35px;
    left: 0;
    white-space: nowrap;
    z-index: 1;
    opacity: 0.35;
    pointer-events: none;
    line-height: 1;
    font-size: clamp(38px, 6vw, 85px);
    font-weight: 900;
    background: linear-gradient(90deg, #ec5c0a, #ff9900, #007b3e, #ec5c0a);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: scroll-left-to-right 18s linear infinite;
  }

  .hero-breadcrumb-pill {
    position: relative;
    z-index: 2;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 204, 0, 0.5);
    border-radius: 50px;
    padding: 8px 24px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.5);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .hero-breadcrumb-pill span, .hero-breadcrumb-pill a {
    color: #ffffff;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }

  .faq-hero-content {
    max-width: 900px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }
  
  .faq-badge-top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 18px;
    background: linear-gradient(90deg, rgba(236, 92, 10, 0.2), rgba(0, 123, 62, 0.2));
    border: 1px solid rgba(255, 204, 0, 0.5);
    border-radius: 50px;
    color: #ffcc00;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 16px;
  }
  .faq-badge-top .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #00ff66;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(0, 255, 102, 0.7);
    animation: pulse-ring 1.8s infinite;
  }
  @keyframes pulse-ring {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 102, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(0, 255, 102, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 102, 0); }
  }

  .faq-hero h1 {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 900;
    margin-bottom: 16px;
    color: #ffffff;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }

  .faq-hero h1 span {
    background: linear-gradient(90deg, #ffcc00, #ec5c0a, #00ff66);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .faq-subheading {
    font-size: clamp(1rem, 2vw, 1.2rem);
    line-height: 1.7;
    color: #cbd5e1;
    max-width: 750px;
    margin: 0 auto;
  }
  
  /* --- Search Bar --- */
  .faq-search-container {
    max-width: 650px;
    margin: 32px auto 0;
    position: relative;
  }
  .faq-search-input {
    width: 100%;
    padding: 18px 24px 18px 56px;
    font-size: 1.05rem;
    border: 2px solid rgba(255, 204, 0, 0.4);
    border-radius: 50px;
    outline: none;
    transition: all 0.3s ease;
    font-family: inherit;
    background: rgba(255, 255, 255, 0.98);
    color: #0f172a;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
  }
  .faq-search-input:focus {
    border-color: #ec5c0a;
    box-shadow: 0 0 0 5px rgba(236, 92, 10, 0.3), 0 15px 35px rgba(0, 0, 0, 0.4);
  }
  .faq-search-icon {
    position: absolute;
    left: 22px;
    top: 50%;
    transform: translateY(-50%);
    color: #ec5c0a;
    font-size: 1.3rem;
  }

  /* --- Category Filter Tabs --- */
  .faq-categories-wrapper {
    max-width: 1100px;
    margin: -25px auto 40px auto;
    position: relative;
    z-index: 5;
    padding: 0 20px;
  }
  .faq-categories {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(236, 92, 10, 0.2);
    border-radius: 50px;
    padding: 10px 14px;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
  }
  .faq-cat-btn {
    padding: 10px 22px;
    background: transparent;
    border: none;
    border-radius: 50px;
    font-size: 0.92rem;
    font-weight: 700;
    color: #475569;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .faq-cat-btn:hover {
    color: #ec5c0a;
    background: rgba(236, 92, 10, 0.08);
  }
  .faq-cat-btn.active {
    background: linear-gradient(135deg, #ec5c0a 0%, #f1721b 100%);
    color: #ffffff !important;
    box-shadow: 0 6px 20px rgba(236, 92, 10, 0.35);
  }

  /* --- FAQ Content Section --- */
  .faq-content-section {
    padding: 10px 20px clamp(60px, 8vw, 100px) 20px;
    max-width: 1080px;
    margin: 0 auto;
  }
  
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* Glassmorphic Accordion Item */
  .faq-item {
    background: #ffffff;
    border-radius: var(--faq-radius);
    border: 1px solid rgba(236, 92, 10, 0.15);
    box-shadow: var(--faq-shadow);
    overflow: hidden;
    transition: all 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);
  }
  .faq-item:hover {
    box-shadow: var(--faq-shadow-hover);
    border-color: rgba(236, 92, 10, 0.35);
    transform: translateY(-2px);
  }
  
  .faq-question {
    width: 100%;
    text-align: left;
    padding: 22px 28px;
    background: transparent;
    border: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    cursor: pointer;
    font-size: 1.12rem;
    font-weight: 800;
    color: var(--faq-text-dark);
    font-family: inherit;
    transition: all 0.25s ease;
    gap: 16px;
  }
  .faq-question:focus-visible {
    outline: 2px solid var(--faq-primary);
    outline-offset: -2px;
  }
  .faq-question:hover {
    color: var(--faq-primary);
  }

  .faq-q-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: rgba(236, 92, 10, 0.1);
    color: var(--faq-primary);
    font-weight: 900;
    font-size: 0.88rem;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }
  .faq-item.is-open .faq-q-num {
    background: var(--faq-primary);
    color: #ffffff;
  }
  
  .faq-question-text {
    flex: 1;
    line-height: 1.4;
  }

  .faq-icon {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 900;
    color: #64748b;
    transition: all 0.3s ease;
  }
  .faq-icon::before {
    content: '+';
  }
  .faq-item.is-open .faq-icon {
    background: #ec5c0a;
    color: #ffffff;
    border-color: #ec5c0a;
    transform: rotate(45deg);
  }
  
  .faq-item.is-open .faq-question {
    color: var(--faq-primary);
    background: rgba(236, 92, 10, 0.03);
    border-bottom: 1px solid rgba(236, 92, 10, 0.12);
  }
  
  .faq-answer-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);
  }
  .faq-item.is-open .faq-answer-wrapper {
    grid-template-rows: 1fr;
  }
  .faq-answer {
    overflow: hidden;
  }
  .faq-answer-inner {
    padding: 26px 28px;
    font-size: 1.02rem;
    line-height: 1.8;
    color: var(--faq-text-light);
    background: #ffffff;
  }
  
  /* Rich Formatting Inside FAQ Answers */
  .faq-answer-inner p { margin-bottom: 14px; }
  .faq-answer-inner p:last-child { margin-bottom: 0; }
  .faq-answer-inner ul, .faq-answer-inner ol { margin-left: 0; margin-bottom: 16px; list-style: none; padding-left: 0; }
  .faq-answer-inner li { margin-bottom: 10px; line-height: 1.7; padding-left: 4px; }
  .faq-answer-inner strong { color: #0f172a; font-weight: 800; }
  .faq-answer-inner small { color: #64748b; font-size: 0.88rem; }
  
  .faq-no-results {
    text-align: center;
    padding: 50px 20px;
    font-size: 1.15rem;
    color: var(--faq-text-light);
    display: none;
    background: #ffffff;
    border-radius: var(--faq-radius);
    border: 1px solid var(--faq-border);
    box-shadow: var(--faq-shadow);
  }

  /* --- Interactive CTA Section --- */
  .faq-cta {
    background: linear-gradient(135deg, #090e1a 0%, #151d30 50%, #0d1527 100%);
    color: #ffffff;
    padding: clamp(60px, 8vw, 90px) 20px;
    text-align: center;
    border-top: 2px solid rgba(255, 204, 0, 0.3);
    position: relative;
    overflow: hidden;
  }
  .faq-cta-content {
    max-width: 750px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }
  .faq-cta h2 {
    color: #ffffff;
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 900;
    margin-bottom: 14px;
  }
  .faq-cta p {
    color: #cbd5e1;
    font-size: 1.1rem;
    margin-bottom: 32px;
    line-height: 1.7;
  }
  .faq-cta-btn-group {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
  }
  .faq-cta-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 36px;
    background: linear-gradient(135deg, #ec5c0a, #f1721b);
    color: #ffffff !important;
    font-size: 1.05rem;
    font-weight: 800;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 12px 30px rgba(236, 92, 10, 0.35);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .faq-cta-btn:hover {
    background: linear-gradient(135deg, #f1721b, #007b3e);
    transform: translateY(-4px) scale(1.03);
    box-shadow: 0 18px 40px rgba(236, 92, 10, 0.5);
  }
  .faq-cta-btn-alt {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 32px;
    background: #ffffff;
    color: #007b3e !important;
    font-size: 1.05rem;
    font-weight: 800;
    text-decoration: none;
    border-radius: 50px;
    border: 2px solid #007b3e;
    box-shadow: 0 8px 20px rgba(0, 123, 62, 0.15);
    transition: all 0.3s ease;
  }
  .faq-cta-btn-alt:hover {
    background: #007b3e;
    color: #ffffff !important;
    transform: translateY(-3px);
  }

  /* Mobile Responsive Fixes (Phones & Tablets) */
  @media screen and (max-width: 768px) {
    .faq-hero {
      padding: 45px 14px 35px 14px !important;
    }
    .faq-moving-text {
      top: 20px !important;
      font-size: 28px !important;
    }
    .hero-breadcrumb-pill {
      padding: 6px 16px !important;
      font-size: 0.78rem !important;
      flex-wrap: wrap !important;
      justify-content: center !important;
      gap: 6px !important;
    }
    .faq-badge-top {
      font-size: 0.72rem !important;
      padding: 5px 12px !important;
      margin-bottom: 12px !important;
    }
    .faq-hero h1 {
      font-size: clamp(1.8rem, 6.5vw, 2.4rem) !important;
      margin-bottom: 10px !important;
    }
    .faq-subheading {
      font-size: 0.88rem !important;
      line-height: 1.6 !important;
    }
    .faq-search-container {
      margin-top: 20px !important;
    }
    .faq-search-input {
      padding: 14px 16px 14px 44px !important;
      font-size: 0.88rem !important;
      border-radius: 40px !important;
    }
    .faq-search-icon {
      left: 16px !important;
      font-size: 1.1rem !important;
    }
    .faq-categories-wrapper {
      margin: -18px auto 25px auto !important;
      padding: 0 10px !important;
    }
    .faq-categories {
      border-radius: 20px !important;
      padding: 6px 8px !important;
      gap: 6px !important;
      flex-wrap: nowrap !important;
      overflow-x: auto !important;
      justify-content: flex-start !important;
      -webkit-overflow-scrolling: touch !important;
    }
    .faq-categories::-webkit-scrollbar {
      display: none;
    }
    .faq-cat-btn {
      flex-shrink: 0 !important;
      padding: 8px 14px !important;
      font-size: 0.78rem !important;
      white-space: nowrap !important;
    }
    .faq-content-section {
      padding: 0 10px 45px 10px !important;
    }
    .faq-item {
      border-radius: 16px !important;
    }
    .faq-question {
      padding: 16px 14px !important;
      font-size: 0.94rem !important;
      gap: 10px !important;
    }
    .faq-q-num {
      width: 26px !important;
      height: 26px !important;
      font-size: 0.75rem !important;
      border-radius: 8px !important;
    }
    .faq-icon {
      width: 26px !important;
      height: 26px !important;
      font-size: 0.95rem !important;
    }
    .faq-answer-inner {
      padding: 18px 14px !important;
      font-size: 0.88rem !important;
      line-height: 1.65 !important;
    }
    .faq-answer-inner p {
      margin-bottom: 10px !important;
    }
    .faq-cta {
      padding: 45px 16px !important;
    }
    .faq-cta h2 {
      font-size: 1.5rem !important;
      margin-bottom: 10px !important;
    }
    .faq-cta p {
      font-size: 0.92rem !important;
      margin-bottom: 24px !important;
    }
    .faq-cta-btn-group {
      flex-direction: column !important;
      width: 100% !important;
      gap: 12px !important;
    }
    .faq-cta-btn, .faq-cta-btn-alt {
      width: 100% !important;
      max-width: 320px !important;
      padding: 14px 20px !important;
      font-size: 0.92rem !important;
      justify-content: center !important;
      text-align: center !important;
    }
  }
{%- endstyle -%}

