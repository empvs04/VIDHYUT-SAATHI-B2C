{%- style -%}
  /* --- Global & Variables --- */
  :root {
    --req-primary: {{ section.settings.primary_color | default: '#ec5c0a' }};
    --req-secondary: #007b3e;
    --req-bg: {{ section.settings.bg_color | default: '#fff8ef' }};
    --req-text-dark: #0f172a;
    --req-text-light: #334155;
    --req-radius: 24px;
    --req-shadow: 0 16px 45px rgba(0, 0, 0, 0.08);
    --req-shadow-hover: 0 25px 55px rgba(236, 92, 10, 0.18);
    --req-border: rgba(236, 92, 10, 0.2);
  }
  
  .req-wrapper {
    font-family: 'Plus Jakarta Sans', 'Outfit', 'Inter', sans-serif;
    color: var(--req-text-dark);
    background: radial-gradient(circle at 50% 0%, rgba(236, 92, 10, 0.06) 0%, #ffffff 45%, rgba(0, 123, 62, 0.05) 100%);
    overflow: hidden;
  }

  /* --- Section 1: Hero Header & Interactive 3D Card Tabs --- */
  .req-hero-section {
    position: relative;
    padding: clamp(50px, 7vw, 90px) 20px 70px 20px;
    background: linear-gradient(135deg, #090e1a 0%, #151d30 50%, #0d1527 100%);
    color: #ffffff;
    overflow: hidden;
    border-bottom: 3px solid rgba(255, 204, 0, 0.4);
  }

  /* Moving Marquee Background Text */
  @keyframes scroll-left-to-right {
    0% { transform: translateX(-50%) translateY(0); }
    100% { transform: translateX(50%) translateY(0); }
  }
  .req-moving-text {
    position: absolute;
    top: 30px;
    left: 0;
    white-space: nowrap;
    z-index: 1;
    opacity: 0.35;
    pointer-events: none;
    line-height: 1;
    font-size: clamp(36px, 5.5vw, 85px);
    font-weight: 900;
    background: linear-gradient(90deg, #ec5c0a, #ff9900, #007b3e, #ec5c0a);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: scroll-left-to-right 18s linear infinite;
  }

  .hero-breadcrumb-pill {
    position: relative;
    z-index: 2;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 204, 0, 0.5);
    border-radius: 50px;
    padding: 8px 24px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.5);
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }
  .hero-breadcrumb-pill span, .hero-breadcrumb-pill a {
    color: #ffffff;
    font-size: 0.92rem;
    font-weight: 600;
    text-decoration: none;
  }

  .req-hero-container {
    max-width: 1280px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .req-hero-header {
    text-align: center;
    max-width: 920px;
    margin: 0 auto 36px auto;
  }

  .req-badge-top {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 22px;
    background: linear-gradient(90deg, rgba(236, 92, 10, 0.25), rgba(0, 123, 62, 0.25));
    border: 1px solid rgba(255, 204, 0, 0.6);
    border-radius: 50px;
    color: #ffcc00;
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 16px;
    box-shadow: 0 6px 20px rgba(255, 204, 0, 0.15);
  }
  .req-badge-top .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #00ff66;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(0, 255, 102, 0.7);
    animation: pulse-ring 1.8s infinite;
  }
  @keyframes pulse-ring {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 102, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(0, 255, 102, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(0, 255, 102, 0); }
  }

  .req-hero-header h1 {
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    font-weight: 900;
    margin-bottom: 14px;
    color: #ffffff;
    line-height: 1.2;
    letter-spacing: -0.5px;
  }

  .req-hero-header h1 span {
    background: linear-gradient(90deg, #ffcc00, #ec5c0a, #00ff66);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .req-hero-subheading {
    font-size: clamp(1.02rem, 2vw, 1.18rem);
    line-height: 1.7;
    color: #cbd5e1;
    max-width: 820px;
    margin: 0 auto;
  }

  /* Golden Rule Top Banner */
  .req-golden-banner {
    background: linear-gradient(135deg, rgba(236, 92, 10, 0.25), rgba(0, 123, 62, 0.25));
    border: 2px solid #ffcc00;
    border-radius: 20px;
    padding: 18px 24px;
    margin-bottom: 35px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4);
    flex-wrap: wrap;
  }
  .req-golden-text {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .req-golden-icon {
    font-size: 2rem;
    flex-shrink: 0;
  }
  .req-golden-info h3 {
    color: #ffcc00;
    font-weight: 900;
    font-size: 1.1rem;
    margin: 0 0 4px 0;
  }
  .req-golden-info p {
    color: #ffffff;
    font-size: 0.94rem;
    margin: 0;
    line-height: 1.5;
  }
  .req-golden-pill {
    padding: 8px 18px;
    background: #ffcc00;
    color: #000000;
    font-weight: 900;
    font-size: 0.88rem;
    border-radius: 50px;
    white-space: nowrap;
    box-shadow: 0 6px 18px rgba(255, 204, 0, 0.3);
  }

  /* Interactive 3D Card Requirement Tabs */
  .req-tabs-wrapper {
    margin-bottom: 35px;
  }
  .req-tabs-nav {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    background: rgba(255, 255, 255, 0.06);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 60px;
    padding: 8px;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.5);
  }

  .req-tab-btn {
    padding: 10px 20px;
    background: transparent;
    border: 1.5px solid transparent;
    border-radius: 50px;
    color: #cbd5e1;
    font-size: 0.92rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.165, 0.84, 0.44, 1);
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: inherit;
  }
  .req-tab-btn:hover {
    color: #ffcc00;
    background: rgba(255, 255, 255, 0.08);
  }
  .req-tab-btn.active {
    background: linear-gradient(135deg, #ec5c0a 0%, #f1721b 100%);
    color: #ffffff !important;
    border-color: rgba(255, 204, 0, 0.6);
    box-shadow: 0 8px 25px rgba(236, 92, 10, 0.4);
    transform: translateY(-2px);
  }
  .req-tab-btn .tab-count {
    background: rgba(255, 255, 255, 0.2);
    padding: 2px 8px;
    border-radius: 20px;
    font-size: 0.78rem;
    font-weight: 900;
  }

  /* Tab Content Panels Stage */
  .req-tab-panel {
    display: none;
    animation: fadeInTab 0.4s ease forwards;
  }
  .req-tab-panel.active {
    display: block;
  }

  /* Lucrative Card Info Showcase Box */
  .req-card-info-dashboard {
    background: rgba(15, 23, 42, 0.88);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 2px solid rgba(255, 204, 0, 0.4);
    border-radius: 28px;
    padding: 32px;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.7);
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media (min-width: 992px) {
    .req-card-info-dashboard {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 40px;
    }
  }

  .req-info-details-left {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .req-dash-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    padding-bottom: 16px;
    gap: 12px;
    flex-wrap: wrap;
  }
  .req-dash-title {
    font-size: 1.6rem;
    font-weight: 900;
    color: #ffffff;
    margin: 0;
  }
  .req-dash-title span {
    color: #ffcc00;
  }
  .req-dash-tag {
    background: linear-gradient(90deg, #007b3e, #00a854);
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 900;
    padding: 6px 16px;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .req-specs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .req-spec-box {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    padding: 16px 18px;
    transition: all 0.3s ease;
  }
  .req-spec-box:hover {
    background: rgba(236, 92, 10, 0.15);
    border-color: rgba(255, 204, 0, 0.4);
    transform: translateY(-2px);
  }
  .req-spec-label {
    font-size: 0.78rem;
    font-weight: 800;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    display: block;
    margin-bottom: 4px;
  }
  .req-spec-value {
    font-size: 1.12rem;
    font-weight: 900;
    color: #ffffff;
    display: block;
  }
  .req-spec-value .highlight {
    color: #00ff66;
  }
  .req-spec-value .highlight-orange {
    color: #ff5500;
  }

  .req-apps-banner {
    background: rgba(0, 123, 62, 0.15);
    border: 1px solid rgba(0, 255, 102, 0.3);
    border-radius: 18px;
    padding: 18px 20px;
  }
  .req-apps-banner h4 {
    font-size: 1rem;
    font-weight: 900;
    color: #00ff66;
    margin: 0 0 8px 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .req-apps-banner p {
    font-size: 0.94rem;
    line-height: 1.6;
    color: #e2e8f0;
    margin: 0;
  }

  .req-info-visual-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 22px;
    padding: 24px;
    text-align: center;
  }
  .req-card-thumb-wrapper {
    width: 100%;
    max-width: 320px;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 15px 35px rgba(0,0,0,0.5), 0 0 30px rgba(236, 92, 10, 0.2);
    border: 2px solid rgba(255, 204, 0, 0.5);
    margin-bottom: 18px;
    transition: transform 0.4s ease;
  }
  .req-card-thumb-wrapper img {
    width: 100%;
    height: auto;
    display: block;
  }

  .req-savings-tag {
    font-size: 1.15rem;
    font-weight: 900;
    color: #ffcc00;
    margin-bottom: 16px;
    background: rgba(255, 204, 0, 0.12);
    padding: 8px 18px;
    border-radius: 50px;
    border: 1px solid rgba(255, 204, 0, 0.3);
  }

  .req-tab-order-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 16px 28px;
    background: linear-gradient(135deg, #ec5c0a, #f1721b);
    color: #ffffff !important;
    font-size: 1.05rem;
    font-weight: 900;
    text-decoration: none;
    border-radius: 50px;
    box-shadow: 0 10px 25px rgba(236, 92, 10, 0.4);
    transition: all 0.3s ease;
  }
  .req-tab-order-btn:hover {
    background: linear-gradient(135deg, #f1721b, #007b3e);
    transform: translateY(-3px);
  }

  .req-multi-rows-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    margin-top: 14px;
  }

  .req-multi-row-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 204, 0, 0.3);
    border-radius: 14px;
    padding: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .req-multi-row-kw {
    font-size: 0.98rem;
    font-weight: 900;
    color: #00ff66;
  }
  .req-multi-row-bill {
    font-size: 0.82rem;
    color: #cbd5e1;
  }
  .req-multi-row-cards {
    background: rgba(236, 92, 10, 0.25);
    border: 1px solid #ec5c0a;
    color: #ffcc00;
    font-size: 0.92rem;
    font-weight: 900;
    padding: 6px 12px;
    border-radius: 8px;
    white-space: nowrap;
  }


  /* ==========================================
     SECTION 2: PRACTICAL SELECTION EXAMPLES (3 SECTORS)
     ========================================== */
  .req-sec2-section {
    padding: clamp(60px, 8vw, 100px) 20px;
    background: #ffffff;
    position: relative;
  }
  .req-sec2-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .req-sec2-header {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 45px auto;
  }

  .req-sec2-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 22px;
    background: rgba(236, 92, 10, 0.1);
    border: 1px solid rgba(236, 92, 10, 0.3);
    border-radius: 50px;
    color: #ec5c0a;
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .req-sec2-header h2 {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    font-weight: 900;
    color: #0f172a;
    margin-bottom: 14px;
    line-height: 1.25;
  }
  .req-sec2-header h2 span {
    background: linear-gradient(90deg, #ec5c0a, #007b3e);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .req-sec2-header p {
    font-size: 1.1rem;
    color: #475569;
    line-height: 1.7;
    margin: 0;
  }

  /* Sector Switcher Tabs Navigation - Ultra-Lucrative High-Visibility 3D Dock */
  .req-sector-tabs-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 16px;
    margin: 0 auto 45px auto;
    flex-wrap: wrap;
    background: #ffffff;
    padding: 12px 18px;
    border-radius: 60px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
    border: 2px solid rgba(241, 126, 57, 0.15);
    max-width: 1100px;
  }
  
  .req-sector-tab {
    padding: 14px 28px;
    background: #ffffff;
    border: 2px solid #e2e8f0;
    border-radius: 50px;
    font-size: 1.05rem;
    font-weight: 800;
    color: #334155;
    cursor: pointer;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-family: inherit;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
    min-height: 52px;
  }

  .req-sector-tab:hover {
    transform: translateY(-3px) scale(1.02);
  }

  /* 🟢 Residential Button Styling */
  .req-sector-tab[data-sector="residential"] {
    border-color: rgba(0, 168, 84, 0.3);
    color: #007b3e;
    background: linear-gradient(135deg, rgba(0, 168, 84, 0.08), rgba(0, 123, 62, 0.03));
  }
  .req-sector-tab[data-sector="residential"]:hover {
    border-color: #00a854;
    box-shadow: 0 8px 25px rgba(0, 168, 84, 0.25);
  }
  .req-sector-tab[data-sector="residential"].active {
    background: linear-gradient(135deg, #007b3e 0%, #00a854 100%);
    color: #ffffff !important;
    border-color: #00a854;
    box-shadow: 0 14px 35px rgba(0, 168, 84, 0.45);
    transform: translateY(-3px) scale(1.03);
  }

  /* 🟠 Commercial Button Styling */
  .req-sector-tab[data-sector="commercial"] {
    border-color: rgba(236, 92, 10, 0.3);
    color: #ec5c0a;
    background: linear-gradient(135deg, rgba(236, 92, 10, 0.08), rgba(255, 119, 0, 0.03));
  }
  .req-sector-tab[data-sector="commercial"]:hover {
    border-color: #ec5c0a;
    box-shadow: 0 8px 25px rgba(236, 92, 10, 0.25);
  }
  .req-sector-tab[data-sector="commercial"].active {
    background: linear-gradient(135deg, #ec5c0a 0%, #ff7700 100%);
    color: #ffffff !important;
    border-color: #ff7700;
    box-shadow: 0 14px 35px rgba(236, 92, 10, 0.45);
    transform: translateY(-3px) scale(1.03);
  }

  /* 🔵 Industrial Button Styling */
  .req-sector-tab[data-sector="industrial"] {
    border-color: rgba(13, 82, 191, 0.3);
    color: #0d52bf;
    background: linear-gradient(135deg, rgba(13, 82, 191, 0.08), rgba(37, 99, 235, 0.03));
  }
  .req-sector-tab[data-sector="industrial"]:hover {
    border-color: #2563eb;
    box-shadow: 0 8px 25px rgba(13, 82, 191, 0.25);
  }
  .req-sector-tab[data-sector="industrial"].active {
    background: linear-gradient(135deg, #0d52bf 0%, #2563eb 100%);
    color: #ffffff !important;
    border-color: #2563eb;
    box-shadow: 0 14px 35px rgba(13, 82, 191, 0.45);
    transform: translateY(-3px) scale(1.03);
  }

  /* Mobile Responsive for 3 Buttons */
  @media screen and (max-width: 768px) {
    .req-sector-tabs-wrapper {
      flex-direction: column;
      border-radius: 24px;
      padding: 14px;
      gap: 12px;
    }
    .req-sector-tab {
      width: 100%;
      box-sizing: border-box;
      justify-content: center;
      padding: 14px 18px;
      font-size: 0.98rem;
    }
  }

  /* Sector Panel Containers */
  .req-sector-panel {
    display: none;
    animation: fadeInPanel 0.4s ease forwards;
  }
  .req-sector-panel.active {
    display: block;
  }

  /* Practical Example Cards Layout */
  .req-examples-grid {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .req-example-card {
    border-radius: 24px;
    overflow: hidden;
    background: #ffffff;
    border: 2px solid #e2e8f0;
    box-shadow: 0 15px 40px rgba(0, 0, 0, 0.06);
    transition: all 0.35s ease;
  }
  .req-example-card:hover {
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.12);
    transform: translateY(-4px);
  }

  /* Theme Colors for Examples */
  .req-theme-green .req-example-card { border-color: rgba(0, 123, 62, 0.3); }
  .req-theme-green .req-ex-header { background: #007b3e; color: #ffffff; }
  .req-theme-green .req-ex-consider { background: #007b3e; color: #ffffff; }
  .req-theme-green .req-ex-3phase-bar { background: rgba(0, 123, 62, 0.08); border-color: #007b3e; color: #007b3e; }
  
  .req-theme-orange .req-example-card { border-color: rgba(236, 92, 10, 0.3); }
  .req-theme-orange .req-ex-header { background: #ec5c0a; color: #ffffff; }
  .req-theme-orange .req-ex-consider { background: #ec5c0a; color: #ffffff; }
  .req-theme-orange .req-ex-3phase-bar { background: rgba(236, 92, 10, 0.08); border-color: #ec5c0a; color: #ec5c0a; }

  .req-theme-blue .req-example-card { border-color: rgba(13, 82, 191, 0.3); }
  .req-theme-blue .req-ex-header { background: #0d52bf; color: #ffffff; }
  .req-theme-blue .req-ex-consider { background: #0d52bf; color: #ffffff; }
  .req-theme-blue .req-ex-3phase-bar { background: rgba(13, 82, 191, 0.08); border-color: #0d52bf; color: #0d52bf; }

  .req-ex-header {
    padding: 14px 24px;
    font-size: 1.1rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    text-align: center;
  }

  .req-ex-body {
    padding: 24px 28px;
  }

  .req-ex-content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: center;
    margin-bottom: 20px;
  }
  @media (min-width: 900px) {
    .req-ex-content-grid {
      grid-template-columns: 300px 1fr 1fr;
      gap: 24px;
    }
  }

  /* Building Photo Showcase Box */
  .req-building-img-box {
    width: 100%;
    height: 200px;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
    border: 2px solid #e2e8f0;
    flex-shrink: 0;
    position: relative;
    background: #0f172a;
  }
  .req-building-img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .req-building-img-box:hover img {
    transform: scale(1.06);
  }

  .req-customer-info {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .req-c-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .req-c-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    background: #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    flex-shrink: 0;
  }
  .req-c-detail span {
    display: block;
