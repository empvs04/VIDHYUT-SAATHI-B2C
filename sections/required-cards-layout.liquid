<script>
document.addEventListener('DOMContentLoaded', function() {
  // Section 1 Cards Tabs Logic
  const tabBtns = document.querySelectorAll('.req-tab-btn');
  const tabPanels = document.querySelectorAll('.req-tab-panel');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => b.classList.remove('active'));
      tabPanels.forEach(p => p.classList.remove('active'));

      btn.classList.add('active');
      const targetTabId = btn.getAttribute('data-tab');
      const targetPanel = document.getElementById(targetTabId);
      if (targetPanel) {
        targetPanel.classList.add('active');
      }
    });
  });

  // Section 2 Sector Switcher Tabs Logic
  const sectorBtns = document.querySelectorAll('.req-sector-tab');
  const sectorPanels = document.querySelectorAll('.req-sector-panel');

  sectorBtns.forEach(sBtn => {
    sBtn.addEventListener('click', () => {
      sectorBtns.forEach(sb => sb.classList.remove('active'));
      sectorPanels.forEach(sp => sp.classList.remove('active'));

      sBtn.classList.add('active');
      const sectorId = sBtn.getAttribute('data-sector');
      const targetSectorPanel = document.getElementById('sector-' + sectorId);
      if (targetSectorPanel) {
        targetSectorPanel.classList.add('active');
      }
    });
  });
});
</script>

