<script>
  function openVsPolicyModal(policyKey) {
    const overlay = document.getElementById('vsPolicyModalOverlay');
    if (!overlay) return;
    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
    switchVsPolicyTab(policyKey);
  }

  function closeVsPolicyModal() {
    const overlay = document.getElementById('vsPolicyModalOverlay');
    if (!overlay) return;
    overlay.classList.remove('active');
    document.body.style.overflow = '';
  }

  function switchVsPolicyTab(policyKey) {
    document.querySelectorAll('.vs-policy-tab-btn').forEach(btn => {
      btn.classList.toggle('active', btn.getAttribute('data-tab') === policyKey);
    });
    document.querySelectorAll('.vs-policy-tab-content').forEach(content => {
      content.classList.toggle('active', content.getAttribute('id') === 'vs-policy-tab-' + policyKey);
    });
    const body = document.getElementById('vsPolicyModalBody');
    if (body) body.scrollTop = 0;
  }

  function initDockFooterAnimations() {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);
      const elements = document.querySelectorAll('#section-{{ section.id }} .v-anim-footer');
      gsap.fromTo(elements, 
        { y: 35, opacity: 0 },
        {
          scrollTrigger: { trigger: "#section-{{ section.id }}", start: "top 95%" },
          y: 0, opacity: 1, duration: 0.7, stagger: 0.1, ease: "power2.out", clearProps: "transform"
        }
      );
    }
  }
  document.addEventListener("DOMContentLoaded", initDockFooterAnimations);
  if (window.Shopify && Shopify.designMode) { setTimeout(initDockFooterAnimations, 200); }
</script>

