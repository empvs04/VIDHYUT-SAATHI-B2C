<!-- INTERACTIVE POLICY MODAL -->
<style>
  .vs-policy-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(2, 6, 23, 0.88);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px 16px;
    box-sizing: border-box;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .vs-policy-modal-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .vs-policy-modal-container {
    background: linear-gradient(165deg, #1e293b 0%, #0f172a 60%, #020617 100%);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 35px 90px rgba(0, 0, 0, 0.8), 0 0 40px rgba(241, 126, 57, 0.1);
    border-radius: 24px;
    width: 100%;
    max-width: 980px;
    max-height: 86vh;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    color: #e2e8f0;
    transform: translateY(24px) scale(0.97);
