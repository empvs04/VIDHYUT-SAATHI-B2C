              <img src="{{ team_avatar_url }}" class="avatar team-avatar-img" decoding="async" loading="lazy" width="1000" height="1000" alt="Vidhyut Saathi Team">
            {%- endif -%}
          </div>
        </div>

      </div>

      <!-- Dedicated Full-Width Sub-Section Bar Below Section 2 Grid -->
      <div class="team-sec2-bottom-banner fadeInUp" data-wow-delay="0.5s">
        
