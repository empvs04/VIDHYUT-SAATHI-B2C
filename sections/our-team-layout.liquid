      <div class="team-marquee-content">Our Team &nbsp; &nbsp; &nbsp; &nbsp; Our Team &nbsp; &nbsp; &nbsp; &nbsp; Our Team &nbsp; &nbsp; &nbsp; &nbsp; Our Team &nbsp; &nbsp; &nbsp; &nbsp; Our Team</div>
    </div>

    <div class="team-hero-inner">
      <div class="row h-100 align-items-center">
        <div class="col-12 text-center">
          <nav aria-label="breadcrumb" class="breadcumb--con text-center">
            <h1 class="w-text title wow fadeInUp" data-wow-delay="0.2s" style="visibility: visible; animation-delay: 0.2s; animation-name: fadeInUp;">
              {{ section.settings.hero_title | default: "Our Vidhyut Saathi Team" }}
