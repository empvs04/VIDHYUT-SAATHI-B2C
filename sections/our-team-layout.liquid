            {%- assign member_role_lower = block.settings.role | downcase -%}
            {%- assign category = 'sales' -%}
            {%- if member_role_lower contains 'head' or member_role_lower contains 'manager' or member_role_lower contains 'co-founder' -%}
              {%- assign category = category | append: ' management' -%}
            {%- endif -%}
            {%- if member_role_lower contains 'training' -%}
              {%- assign category = 'training management' -%}
            {%- elsif member_role_lower contains 'relationship' -%}
              {%- assign category = 'relationship management' -%}
            {%- elsif member_role_lower contains 'accounting' or member_role_lower contains 'account' -%}
              {%- assign category = 'accounts management' -%}
            {%- elsif member_role_lower contains 'marketing' -%}
              {%- assign category = category | append: ' sales' -%}
            {%- endif -%}

            <div class="untitled-card team-card-item {{ category }}" {{ block.shopify_attributes }}>
              <div class="untitled-card-image-wrapper">
                <span class="untitled-status-dot"></span>
                {%- if block.settings.image != blank -%}
