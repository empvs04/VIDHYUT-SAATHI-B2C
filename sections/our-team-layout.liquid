  </section>

  <!-- Section 2: Vidhyut Saathi Team Overview -->
  <section class="team-sec2-section">
    <div class="team-sec2-container">
      
      <!-- Top Center Badge Header -->
      <div class="dream-dots text-center fadeInUp" data-wow-delay="0.2s" style="display: flex; justify-content: center; margin-bottom: 24px; width: 100%;">
        <span class="gradient-text blue animate-charcter">{{ section.settings.sec2_badge | default: "⚡ DEDICATED ENERGY INNOVATORS" }}</span>
      </div>

      <div class="team-sec2-row">
        
        <!-- Text Side -->
        <div class="team-sec2-col-text heading-primary-sub">
          <div class="who-we-contant heading-primary-sub">

            <h4 class="sec2-team-title fadeInUp" data-wow-delay="0.3s">
              {{ section.settings.sec2_title | default: "Vidhyut Saathi Team" }}
              <span class="title-gradient-span">Pioneering Energy Savings Across India</span>
            </h4>

            <p class="sec2-team-text fadeInUp" data-wow-delay="0.4s">
              Behind Vidhyut Saathi Energy Savers Pvt. Ltd. is a dynamic team of industry experts, engineers, business strategists, and customer success professionals committed to driving sustainable growth. Our team works closely with every franchise partner, providing comprehensive training, technical expertise, sales support, and strategic marketing assistance to ensure long-term business success.
            </p>

            <p class="sec2-team-text fadeInUp" data-wow-delay="0.4s">
              We don't just supply products—we build profitable partnerships backed by innovation, transparency, and continuous guidance. With a customer-first approach and a passion for excellence, our professionals are dedicated to helping entrepreneurs expand confidently while delivering high-quality energy-saving solutions that create lasting value for homes, businesses, industries, and institutions across India.
            </p>

          </div>
        </div>

        <!-- Image Side -->
        <div class="team-sec2-col-img heading-primary-main">
