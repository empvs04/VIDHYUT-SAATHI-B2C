        <button type="button" class="team-filter-btn" data-filter="sales">Sales &amp; Marketing</button>
        <button type="button" class="team-filter-btn" data-filter="management">Management</button>
        <button type="button" class="team-filter-btn" data-filter="training">Training</button>
        <button type="button" class="team-filter-btn" data-filter="relationship">Relationship</button>
        <button type="button" class="team-filter-btn" data-filter="accounts">Accounts</button>
