    position: relative;
    overflow: hidden;
  }
  .wwa-container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 36px;
    align-items: stretch; /* Left & Right Containers match exact equal height line */
  }
  
  /* Left Media Container */
  .wwa-image {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .wwa-image-wrapper {
    position: relative;
